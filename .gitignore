# Digital Signal and Image Processing - Academic Repository
# Specialized .gitignore for signal processing and scholarly archiving

# OS-generated files
[Tt]humbs.db
[Dd]esktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Editor and IDE configuration
.vscode/
.idea/
*.swp
*.swo
*~
*.iml
*.code-workspace

# MATLAB
*.asv
*.m~
*.slxc
*.mex*
*.log
*.p
*.fig
*.mlappinstall
*.mlpkginstall

# Python Build Artifacts
__pycache__/
*.py[cod]
*$py.class
venv/ env/
.env

# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Office Temporary Files
~$*.doc
~$*.docx
~$*.ppt
~$*.pptx
~$*.xls
~$*.xlsx

# LaTeX / Document Artifacts
*.aux
*.bbl
*.blg
*.idx
*.ind
*.lof
*.lot
*.out
*.toc
*.log
*.synctex.gz

# Archives
*.zip
*.tar.gz
*.rar
*.7z

# Temporary and Cache files
*.tmp
*.log
.cache/

# Academic build/output artifacts
*.bak
*.sav
*.old
*.orig
